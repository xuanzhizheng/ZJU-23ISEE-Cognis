\PYG{c+c1}{\PYGZsh{} Step 3: 类间离散度矩阵Sb}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{compute\PYGZus{}Sb}\PYG{p}{(}\PYG{n}{x1}\PYG{p}{,} \PYG{n}{x2}\PYG{p}{)}\PYG{p}{:}
