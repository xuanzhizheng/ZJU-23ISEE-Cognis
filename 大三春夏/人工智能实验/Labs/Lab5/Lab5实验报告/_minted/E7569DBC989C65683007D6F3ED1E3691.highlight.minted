\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{numpy}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{mean}\PYG{p}{,} \PYG{n}{cov}\PYG{p}{,} \PYG{n}{linalg}
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{numpy}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{np}
\PYG{n}{mat}     \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{matrix}
\PYG{n}{argsort} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{argsort}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{loadDataSet}\PYG{p}{(}\PYG{n}{fileName}\PYG{p}{,} \PYG{n}{delim}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+se}{\PYGZbs{}t}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}\PYG{p}{:}
    \PYG{n}{fr} \PYG{o}{=} \PYG{n+nb}{open}\PYG{p}{(}\PYG{n}{fileName}\PYG{p}{)}
    \PYG{n}{stringArr} \PYG{o}{=} \PYG{p}{[}\PYG{n}{line}\PYG{o}{.}\PYG{n}{strip}\PYG{p}{(}\PYG{p}{)}\PYG{o}{.}\PYG{n}{split}\PYG{p}{(}\PYG{n}{delim}\PYG{p}{)} \PYG{k}{for} \PYG{n}{line} \PYG{o+ow}{in} \PYG{n}{fr}\PYG{o}{.}\PYG{n}{readlines}\PYG{p}{(}\PYG{p}{)}\PYG{p}{]}
    \PYG{n}{datArr}    \PYG{o}{=} \PYG{p}{[}\PYG{n+nb}{list}\PYG{p}{(}\PYG{n+nb}{map}\PYG{p}{(}\PYG{n+nb}{float}\PYG{p}{,} \PYG{n}{line}\PYG{p}{)}\PYG{p}{)} \PYG{k}{for} \PYG{n}{line} \PYG{o+ow}{in} \PYG{n}{stringArr}\PYG{p}{]}
    \PYG{k}{return} \PYG{n}{mat}\PYG{p}{(}\PYG{n}{datArr}\PYG{p}{)}

\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{pca}\PYG{p}{(}\PYG{n}{dataMat}\PYG{p}{,} \PYG{n}{topNfeat}\PYG{o}{=}\PYG{l+m+mi}{9999999}\PYG{p}{)}\PYG{p}{:}
    \PYG{n}{meanVals}    \PYG{o}{=} \PYG{n}{mean}\PYG{p}{(}\PYG{n}{dataMat}\PYG{p}{,} \PYG{n}{axis}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{)}
    \PYG{n}{meanRemoved} \PYG{o}{=} \PYG{n}{dataMat} \PYG{o}{\PYGZhy{}} \PYG{n}{meanVals}            \PYG{c+c1}{\PYGZsh{} remove mean}
    \PYG{n}{covMat}      \PYG{o}{=} \PYG{n}{cov}\PYG{p}{(}\PYG{n}{meanRemoved}\PYG{p}{,} \PYG{n}{rowvar}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{)}
    \PYG{n}{eigVals}\PYG{p}{,} \PYG{n}{eigVects} \PYG{o}{=} \PYG{n}{linalg}\PYG{o}{.}\PYG{n}{eig}\PYG{p}{(}\PYG{n}{mat}\PYG{p}{(}\PYG{n}{covMat}\PYG{p}{)}\PYG{p}{)}
    \PYG{n}{eigValInd}   \PYG{o}{=} \PYG{n}{argsort}\PYG{p}{(}\PYG{n}{eigVals}\PYG{p}{)}              \PYG{c+c1}{\PYGZsh{} sort: small \PYGZhy{}\PYGZgt{} large}
    \PYG{n}{eigValInd}   \PYG{o}{=} \PYG{n}{eigValInd}\PYG{p}{[}\PYG{p}{:}\PYG{o}{\PYGZhy{}}\PYG{p}{(}\PYG{n}{topNfeat}\PYG{o}{+}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{p}{:}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}  \PYG{c+c1}{\PYGZsh{} keep top N}
    \PYG{n}{redEigVects} \PYG{o}{=} \PYG{n}{eigVects}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,} \PYG{n}{eigValInd}\PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{} (1)将数据投影到 N 维新空间}
    \PYG{n}{lowDDataMat} \PYG{o}{=} \PYG{n}{meanRemoved} \PYG{o}{*} \PYG{n}{redEigVects}
    \PYG{c+c1}{\PYGZsh{} (2)从低维空间恢复到原始空间}
    \PYG{n}{reconMat}    \PYG{o}{=} \PYG{p}{(}\PYG{n}{lowDDataMat} \PYG{o}{*} \PYG{n}{redEigVects}\PYG{o}{.}\PYG{n}{T}\PYG{p}{)} \PYG{o}{+} \PYG{n}{meanVals}
    \PYG{k}{return} \PYG{n}{lowDDataMat}\PYG{p}{,} \PYG{n}{reconMat}
\end{MintedVerbatim}
