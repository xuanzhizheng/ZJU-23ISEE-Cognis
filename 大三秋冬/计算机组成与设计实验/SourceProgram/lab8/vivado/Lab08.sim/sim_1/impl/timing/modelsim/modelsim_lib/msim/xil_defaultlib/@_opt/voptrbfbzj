library verilog;
use verilog.vl_types.all;
entity pipeline_adder is
    port(
        clk             : in     vl_logic;
        a               : in     vl_logic_vector(31 downto 0);
        b               : in     vl_logic_vector(31 downto 0);
        ci              : in     vl_logic;
        s               : out    vl_logic_vector(31 downto 0);
        co              : out    vl_logic
    );
end pipeline_adder;
